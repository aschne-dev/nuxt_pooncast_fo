# Configuration publique de l'application web Firebase (valeurs factices)
NUXT_FIREBASE_API_KEY=votre-cle-web-firebase
NUXT_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NUXT_FIREBASE_PROJECT_ID=votre-projet
NUXT_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NUXT_FIREBASE_MESSAGING_SENDER_ID=000000000000
NUXT_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# Analytics optionnel, activé uniquement après consentement
NUXT_META_PIXEL_ID=000000000000000

# URL publique sans slash final des Cloud Functions de formulaires
NUXT_FUNCTIONS_BASE_URL=https://europe-west1-votre-projet.cloudfunctions.net

# Sitekey publique hCaptcha (la valeur production reste le défaut du code)
NUXT_HCAPTCHA_SITEKEY=votre-sitekey-publique-hcaptcha

# true uniquement pour un environnement hors production publiquement accessible
NUXT_STAGING_NOINDEX=false
